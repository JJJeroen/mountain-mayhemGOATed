{
  "name": "mountain-mayhem-goated",
  "version": "0.1.0",
  "private": true,
  "description": "Mountain Mayhem: GOATed - a silly goat-racing party game (web + Android via Capacitor).",
  "homepage": "https://github.com/JJJeroen/mountain-mayhemGOATed",
  "repository": { "type": "git", "url": "git+https://github.com/JJJeroen/mountain-mayhemGOATed.git" },
  "type": "module",
  "scripts": {
    "test": "node test.js && npm run check:sync",
    "sync": "cp engine.js bots.js web/",
    "check:sync": "diff -q engine.js web/engine.js && diff -q bots.js web/bots.js",
    "sim": "node sim.js --quick --games 400 --procs 4",
    "cap:sync": "cap sync android"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "@capacitor/cli": "^8.5.2" },
  "dependencies": { "@capacitor/android": "^8.5.2", "@capacitor/core": "^8.5.2" }
}
